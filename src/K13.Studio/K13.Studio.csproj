    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vorotex.Studio</RootNamespace>
    <AssemblyName>VorotexK13Studio</AssemblyName>
    <Product>VOROTEX K13 Studio</Product>
